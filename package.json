    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/three": "^0.170.0",
    "pg": "^8.23.1",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
