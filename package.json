    "art:build:props": "node scripts/build-props.mjs && node scripts/build-wooden-bridge.mjs",
    "art:build:medieval": "node scripts/build-medieval-wardrobe.mjs && node scripts/build-medieval-bridges.mjs",
    "art:build:bridges": "node scripts/build-medieval-bridges.mjs && node scripts/build-wooden-bridge.mjs",
    "test:bridges": "node --test scripts/test-bridges.mjs",
    "art:check": "node --test scripts/test-wardrobe.mjs",
