    "assets:check": "node --test scripts/test-assets.mjs",
    "assets:check:browser": "node --test scripts/test-assets-browser.mjs",
    "art:ambient": "node tools/prepare-ambient-animations.mjs",
    "art:hamlet": "node tools/build-hamlet.mjs && node tools/register-hamlet.mjs",
    "art:arboleda": "node tools/build-arboleda.mjs && node tools/register-arboleda.mjs",
    "test:arboleda": "node --test scripts/test-arboleda.mjs",
    "test:hamlet": "node --test scripts/test-hamlet.mjs",
    "art:creator": "node tools/prepare-creator-parts.mjs",
    "test:creator": "npm run build && node --test scripts/test-creator.mjs",
    "test:creator:fit": "node --test scripts/test-creator-fit.mjs",
    "art:creator:review": "node tools/render-creator.mjs",
    "test:ambient": "npm run build && node --test scripts/test-ambient.mjs",
    "test:combat": "node --test scripts/test-combat.mjs",
    "test:combat:intro": "node --test scripts/test-intro-combat.mjs",
    "test:combat:balance": "node --test scripts/test-combat-balance.mjs",
    "test:npcs": "node --test scripts/test-npcs.mjs",
    "test:maps": "node --test scripts/test-maps.mjs",
    "test:brumaluz": "node --test scripts/test-brumaluz-city.mjs",
    "test:water": "node --test scripts/test-water.mjs",
    "test:daynight": "node --test scripts/test-daynight.mjs",
    "test:music": "node --test scripts/test-day-music.mjs",
    "music:render": "node tools/render-day-music.mjs"
  },
  "keywords": [],
