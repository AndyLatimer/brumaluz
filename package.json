    "test:world:db": "node scripts/test-world-db.mjs",
    "test:trade": "npm run build && node --test scripts/test-trade.mjs",
    "test:trade:db": "node scripts/test-trade-db.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
